<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications for com.seojigwon.workboard (team K6599UJ4KM, the
	     App ID has the Push Notifications capability). Xcode's automatic
	     signing turns this into "production" for TestFlight and App Store
	     builds. See docs/ios-design.md, "Push". -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
