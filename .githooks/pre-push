#!/bin/sh
# Claude Code sessions push to main only a fast-forward commit, and never
# delete main. Tests are not required before a push; run `scripts/wt verify`
# by hand when you want them. `scripts/wt ship` fetches, rebases and pushes.
# Pushes made by people (no CLAUDECODE) are not affected.
[ -n "$CLAUDECODE" ] || exit 0
while read -r lref lsha rref rsha; do
  [ "$rref" = refs/heads/main ] || continue
  case $lsha in *[!0]*) ;; *) echo "pre-push: deleting main is not allowed" >&2; exit 1 ;; esac
  case $rsha in
    *[!0]*)
      if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
        echo "pre-push: not a fast-forward of main. Run scripts/wt ship (it fetches and rebases)." >&2
        exit 1
      fi ;;
  esac
done
exit 0
