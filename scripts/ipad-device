#!/bin/sh
# Build the desktop (egui) app for a real iPad, sign it for development and
# install it on the iPad connected to this Mac. Experimental: see docs/ipad.md.
#   scripts/ipad-device              the first iPad devicectl sees
#   WB_IPAD_ID=<udid> scripts/ipad-device
#   WB_DEBUG=1 scripts/ipad-device   a debug build (quicker to build, slower)
#
# The signing profile comes from Xcode's automatic signing: the iPhone app's
# project is built once with this app's bundle id, which registers the iPad
# with the team and makes a development profile for it. It is kept in
# target/ipad-device/ and made again when the iPad isn't in it.
set -eu
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"
bundle=com.seojigwon.workboard.desk
team=K6599UJ4KM
target=aarch64-apple-ios
out=target/ipad-device
mkdir -p "$out"

device="${WB_IPAD_ID:-}"
if [ -z "$device" ]; then
    xcrun devicectl list devices --json-output "$out/devices.json" >/dev/null
    device=$(python3 -c '
import json, sys
for d in json.load(open(sys.argv[1]))["result"]["devices"]:
    hw = d.get("hardwareProperties", {})
    if hw.get("deviceType") == "iPad" and hw.get("reality") != "simulated":
        print(hw.get("udid", "")); break
' "$out/devices.json")
fi
[ -n "$device" ] || { echo "ipad-device: no iPad connected (cable, unlock, Trust This Computer)" >&2; exit 1; }
echo "ipad-device: iPad $device"

profile="$out/desk.mobileprovision"
has_device() {
    [ -f "$profile" ] && security cms -D -i "$profile" 2>/dev/null | grep -q "$device"
}
if ! has_device; then
    echo "ipad-device: making a development profile (Xcode automatic signing)"
    # (Xcode's module cache breaks on a folder with a space in its path)
    dd="${TMPDIR:-/tmp}/wb-ipad-device"
    xcodebuild -project ios/Workboard.xcodeproj -scheme Workboard -configuration Debug \
        -destination "id=$device" -derivedDataPath "$dd" -allowProvisioningUpdates \
        PRODUCT_BUNDLE_IDENTIFIER="$bundle" CODE_SIGN_ENTITLEMENTS=ios/Config/Workboard.entitlements \
        build >"$out/xcode.log" 2>&1 ||
        { grep -E "error|Signing|Provision" "$out/xcode.log" | tail -20 >&2; exit 1; }
    cp "$dd/Build/Products/Debug-iphoneos/Workboard.app/embedded.mobileprovision" "$profile"
    has_device || { echo "ipad-device: the profile doesn't list this iPad" >&2; exit 1; }
fi

if [ "${WB_DEBUG:-}" = 1 ]; then
    cargo build --target "$target"
    bin="target/$target/debug/workboard"
else
    cargo build --release --target "$target"
    bin="target/$target/release/workboard"
fi

app="$out/Workboard Desk.app"
rm -rf "$app"
mkdir -p "$app"
cp ios/ipad-egui/Info.plist "$app/"
cp "$bin" "$app/workboard"
cp "$profile" "$app/embedded.mobileprovision"
# push notifications (src/notifier.rs), when the profile allows them
aps=
if security cms -D -i "$profile" 2>/dev/null | grep -q "aps-environment"; then
    aps="
	<key>aps-environment</key>
	<string>development</string>"
fi
cat >"$out/entitlements.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>$team.$bundle</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$team</string>
	<key>get-task-allow</key>
	<true/>$aps
</dict>
</plist>
EOF
identity=$(security find-identity -v -p codesigning | grep "Apple Development" | head -1 | sed -E 's/.*"(.*)"/\1/')
[ -n "$identity" ] || { echo "ipad-device: no Apple Development certificate in the keychain" >&2; exit 1; }
codesign --force --sign "$identity" --entitlements "$out/entitlements.plist" "$app"
xcrun devicectl device install app --device "$device" "$app"
xcrun devicectl device process launch --device "$device" "$bundle" || true
echo "ipad-device: installed on $device"
