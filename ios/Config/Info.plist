<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE).
	     Plain http:// and ws:// are allowed to any address, like the Mac app:
	     the team server is plain HTTP on the tailnet, reached by a Tailscale
	     IP (100.x.y.z), a short MagicDNS name ("macmini") or a *.ts.net name,
	     and ATS exceptions can't name IP addresses or short names. Tailscale
	     already encrypts that traffic. Only NSAllowsArbitraryLoads is set:
	     iOS ignores it when NSAllowsLocalNetworking or exception domains are
	     present too. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Workboard uses the microphone for huddles with your team.</string>
	<key>NSCameraUsageDescription</key>
	<string>Workboard uses the camera when you turn on video in a huddle.</string>
	<!-- keep a huddle's audio going when the app goes to the background -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<!-- invite links: workboard://join?server=HOST:PORT&code=XXXX-XXXX-XXXX&email=... -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Workboard invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>workboard</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Workboard connects to your team's server on your network.</string>
</dict>
</plist>
